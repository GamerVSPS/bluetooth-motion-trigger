#include <SoftwareSerial.h>

// Define hardware pins based on the wiring diagram
const int irSensorPin = 2;   // IR Sensor OUT pin
const int btRxPin = 0;      // Bluetooth TX connects here
const int btTxPin = 1;      // Bluetooth RX connects here

// Set up the Bluetooth serial connection
SoftwareSerial BTSerial(btRxPin, btTxPin);

// Variables to track the sensor state
int currentIrState = 0;      
int previousIrState = 1;     // Assume path is clear at startup

void setup() {
  // Configure the IR pin as an input
  pinMode(irSensorPin, INPUT);

  // Initialize the main Serial Monitor for computer debugging
  Serial.begin(9600);
  
  // Initialize the Bluetooth Serial port
  // Note: 9600 is the default baud rate for most HC-05/HC-06 modules
  BTSerial.begin(9600);

  Serial.println("System starting...");
  BTSerial.println("System starting...");
  delay(1000);
  
  Serial.println("Ready. Monitoring for motion...");
  BTSerial.println("Ready. Monitoring for motion...");
}

void loop() {
  // Read the current state of the IR sensor
  // Most standard IR obstacle sensors output LOW (0) when an object is detected
  currentIrState = digitalRead(irSensorPin);

  // Check if the state just changed from clear (1) to blocked (0)
  if (currentIrState == LOW && previousIrState == HIGH) {
    
    // Print to PC Serial Monitor
    Serial.println("ALERT: Motion Detected!");
    
    // Transmit over Bluetooth to your phone
    BTSerial.println("ALERT: Motion Detected!");
    
    delay(50); // Small delay to debounce the sensor
  }
  
  // Check if the state just changed from blocked (0) back to clear (1)
  else if (currentIrState == HIGH && previousIrState == LOW) {
    
    Serial.println("Path clear.");
    BTSerial.println("Path clear.");
    
    delay(50); // Small delay to debounce
  }

  // Save the current state for the next loop comparison
  previousIrState = currentIrState;
}
