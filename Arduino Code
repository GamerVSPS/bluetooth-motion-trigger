#include <SoftwareSerial.h>

const int irSensorPin = 2;
const int btRxPin = 0;
const int btTxPin = 1;   

SoftwareSerial BTSerial(btRxPin, btTxPin);

int currentIrState = 0;      
int previousIrState = 1;

void setup() {
  pinMode(irSensorPin, INPUT);

  Serial.begin(9600);
  BTSerial.begin(9600);

  Serial.println("System starting...");
  BTSerial.println("System starting...");
  delay(1000);

  Serial.println("Ready. Monitoring for motion...");
  BTSerial.println("Ready. Monitoring for motion...");
}

void loop() {
  
  currentIrState = digitalRead(irSensorPin);

  if (currentIrState == LOW && previousIrState == HIGH) {

    Serial.println("ALERT: Motion Detected!");

    BTSerial.println("ALERT: Motion Detected!");
    delay(50);
  }

 blocked (0) back to clear (1)
  else if (currentIrState == HIGH && previousIrState == LOW) {

    Serial.println("Path clear.");
    BTSerial.println("Path clear.");
    delay(50);
  }
  previousIrState = currentIrState;
}